{
  "name": "@tangent/agent-shell",
  "version": "0.1.0",
  "description": "Tangent's Agent Shell server, browser interface, and CLI.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./area-resources": {
      "types": "./app/area-resources.d.ts",
      "import": "./app/area-resources.mjs"
    }
  },
  "files": [
    "dist",
    "app",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node app/build-browser.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node app/gateway.mjs",
    "test": "npm run build -w @tangent/core && npm run build -w @tangent/agent-runtime && npm run build -w @tangent/repo && npm run build && node --test test/*.test.mjs",
    "test:app": "node --test app/*.test.mjs",
    "test:area-map-browser": "TANGENT_BROWSER_TEST=1 node --test app/area-board-browser.test.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@tangent/agent-runtime": "^0.1.0",
    "@tangent/core": "^0.1.0",
    "@tangent/pricing": "^0.1.0",
    "@tangent/repo": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "d3-force": "^3.0.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.25.12"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
