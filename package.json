{
  "name": "tangent",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace for local coding-agent conversation tools.",
  "type": "module",
  "bin": {
    "tangent": "./dist/cli/index.js"
  },
  "workspaces": [
    "packages/agent-runtime",
    "packages/core",
    "packages/repo",
    "packages/hooks",
    "packages/governance",
    "packages/usage",
    "packages/daily",
    "packages/eval",
    "packages/search"
  ],
  "scripts": {
    "build": "npm run build --workspaces && tsc -p tsconfig.json && chmod +x dist/cli/index.js",
    "check": "npm run check --workspaces && tsc -p tsconfig.json --noEmit",
    "governance": "npm run build -w @tangent/governance && node packages/governance/dist/cli/index.js lint",
    "test": "npm run test --workspaces --if-present",
    "clean": "rm -rf dist packages/*/dist"
  },
  "dependencies": {
    "@tangent/agent-runtime": "file:packages/agent-runtime",
    "@tangent/core": "file:packages/core",
    "@tangent/repo": "file:packages/repo",
    "@tangent/hooks": "file:packages/hooks",
    "@tangent/governance": "file:packages/governance",
    "@tangent/usage": "file:packages/usage",
    "@tangent/daily": "file:packages/daily",
    "@tangent/eval": "file:packages/eval",
    "@tangent/search": "file:packages/search"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=24"
  }
}
