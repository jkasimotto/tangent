{
  "name": "@tangent/trees-runtime",
  "version": "0.1.0",
  "description": "Runtime adapters for Tangent Trees storage, git, terminal, agents, attention, and projections.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/fs/index.d.ts",
      "import": "./dist/fs/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "import": "./dist/sqlite/index.js"
    },
    "./git": {
      "types": "./dist/git/index.d.ts",
      "import": "./dist/git/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "import": "./dist/terminal/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./attention": {
      "types": "./dist/attention/index.d.ts",
      "import": "./dist/attention/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build -w @tangent/trees-schema && npm run build -w @tangent/trees-core && npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@tangent/agent-runtime": "^0.1.0",
    "@tangent/core": "^0.1.0",
    "@tangent/repo": "^0.1.0",
    "@tangent/trees-core": "^0.1.0",
    "@tangent/trees-schema": "^0.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
