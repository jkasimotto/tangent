{
  "name": "@convos/convos",
  "version": "0.1.0",
  "description": "Local conversation telemetry and queryability for coding-agent sessions.",
  "type": "module",
  "bin": {
    "convos": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "dependencies": {
    "@tangent/core": "file:../core"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "node --enable-source-maps dist/cli/index.js"
  },
  "keywords": [
    "codex",
    "claude-code",
    "telemetry",
    "jsonl",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
