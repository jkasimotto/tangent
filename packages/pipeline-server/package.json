{
  "name": "@tangent/pipeline-server",
  "version": "0.1.0",
  "description": "Local UI server adapter that reads the feature dossier for the Tangent Designs view.",
  "type": "module",
  "tangent": {
    "uiApp": {
      "id": "pipeline",
      "label": "Designs",
      "serverExport": "@tangent/pipeline-server",
      "factory": "createPipelineUiApp",
      "order": 15
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build -w @tangent/core && npm run build -w @tangent/ui-server && npm run build -w @tangent/pipeline-ui && npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@tangent/core": "^0.1.0",
    "@tangent/pipeline-ui": "^0.1.0",
    "@tangent/ui-server": "^0.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "private": true
}
