{
  "name": "@tangent/trees-ui",
  "version": "0.1.0",
  "description": "React command center UI for Tangent Trees.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./dist/index.js"
    },
    "./assets": {
      "types": "./src/assets.ts",
      "import": "./dist/assets.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tangent/trees-ui-data": "^0.1.0",
    "@tangent/ui-app-shell": "^0.1.0",
    "@tangent/ui-components": "^0.1.0",
    "@tangent/ui-patterns": "^0.1.0",
    "@tangent/ui-primitives": "^0.1.0",
    "@tangent/ui-tokens": "^0.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^6.3.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
