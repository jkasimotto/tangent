{
  "name": "tangent",
  "version": "0.1.0",
  "description": "Workspace for local coding-agent conversation tools.",
  "type": "module",
  "tangent": {
    "packageMode": "thin-shell"
  },
  "bin": {
    "tangent": "./dist/cli/index.js"
  },
  "workspaces": [
    "packages/agent-runtime",
    "packages/agent-shell",
    "packages/core",
    "packages/repo",
    "packages/governance",
    "packages/usage-core",
    "packages/usage-index-sqlite",
    "packages/usage-providers",
    "packages/usage",
    "packages/ui-tokens",
    "packages/ui-server",
    "packages/usage-ui-data",
    "packages/usage-ui",
    "packages/rollup",
    "packages/eval",
    "packages/eval-ui",
    "packages/search",
    "packages/threads"
  ],
  "scripts": {
    "build": "npm run build --workspaces && tsc -p tsconfig.json && chmod +x dist/cli/index.js",
    "check": "npm run check --workspaces && tsc -p tsconfig.json --noEmit",
    "tangent:check-boundaries": "npm run build -w @tangent/governance && node packages/governance/dist/cli/index.js lint deps",
    "hooks:install": "node scripts/install-githooks.mjs",
    "lint:function-docstrings": "node scripts/lint-function-docstrings.mjs",
    "governance": "npm run build -w @tangent/governance && node packages/governance/dist/cli/index.js lint",
    "test": "npm run test --workspaces --if-present && node --test test/*.test.mjs",
    "test:install": "node scripts/smoke-install-packages.mjs",
    "test:install:all-managers": "node scripts/smoke-install-packages.mjs --all-package-managers",
    "clean": "rm -rf dist packages/*/dist"
  },
  "dependencies": {
    "@tangent/core": "^0.1.0"
  },
  "peerDependencies": {
    "@tangent/agent-shell": "^0.1.0",
    "@tangent/eval": "^0.1.0",
    "@tangent/governance": "^0.1.0",
    "@tangent/rollup": "^0.1.0",
    "@tangent/search": "^0.1.0",
    "@tangent/threads": "^0.1.0",
    "@tangent/usage": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@tangent/agent-shell": {
      "optional": true
    },
    "@tangent/eval": {
      "optional": true
    },
    "@tangent/governance": {
      "optional": true
    },
    "@tangent/rollup": {
      "optional": true
    },
    "@tangent/search": {
      "optional": true
    },
    "@tangent/threads": {
      "optional": true
    },
    "@tangent/usage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.10",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.5.4",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@11.10.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true
  }
}
