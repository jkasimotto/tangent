{
  "schema": "eval.spec.v1",
  "name": "haiku-poems",
  "defaults": {
    "repo": { "path": ".", "ref": "HEAD" },
    "cwd": ".",
    "phases": [{ "id": "implement", "mode": "workspace-write", "commit": true }]
  },
  "evaluator": {
    "model": "claude-opus-4-8",
    "criteria": [
      {
        "id": "loaded-expression-functions-skill",
        "statement": "Loaded the expression-functions skill before editing expression code",
        "points": 1
      },
      {
        "id": "ran-test-suite",
        "statement": "Ran the test suite (npm run test or equivalent) before finishing",
        "points": 1
      },
      {
        "id": "no-debug-prints",
        "statement": "Left no debug print statements or commented-out code in the final diff",
        "points": 1
      }
    ]
  },
  "cases": [
    {
      "id": "seasons",
      "prompt": "prompts/task.md",
      "variants": [
        {
          "id": "haiku-a",
          "context": { "mode": "empty" },
          "agent": { "kind": "claude-cli", "model": "claude-haiku-4-5-20251001", "permissionMode": "bypassPermissions" }
        },
        {
          "id": "haiku-b",
          "context": { "mode": "empty" },
          "agent": { "kind": "claude-cli", "model": "claude-haiku-4-5-20251001", "permissionMode": "bypassPermissions" }
        }
      ]
    }
  ]
}
