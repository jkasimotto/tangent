{
  "name": "@tangent/search",
  "version": "0.1.0",
  "description": "Structural repository search for Tangent.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "build:rust": "cargo build -p tangent-search-engine",
    "test": "npm run build && npm run build:rust && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@tangent/core": "file:../core",
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  },
  "engines": {
    "node": ">=24"
  }
}
