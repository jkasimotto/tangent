{
  "name": "@tangent/trees-cli",
  "version": "0.1.0",
  "description": "Command-line surface for Tangent Trees.",
  "type": "module",
  "bin": {
    "tangent-trees": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tangent/core": "^0.1.0",
    "@tangent/trees-core": "^0.1.0",
    "@tangent/trees-mcp": "^0.1.0",
    "@tangent/trees-runtime": "^0.1.0",
    "@tangent/trees-schema": "^0.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
